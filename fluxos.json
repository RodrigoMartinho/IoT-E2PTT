    {
        "id": "35f7540ddd6346bb",
        "type": "function",
        "z": "f00ad3ea53f3c7ed",
        "name": "Salvar Status Luz",
        "func": "if (!msg.payload) return null;\n\n\n// 2. Mapeia os dados vindo do ESP32 (Atenção aos nomes exatos)\nvar status = msg.payload;\n\n// 3. Monta a Query SQL garantindo que nenhum valor seja nulo\nmsg.topic = \"INSERT INTO Historico (sensor, status) VALUES ('Luz', '\" + status + \"')\";\n\n\nreturn msg;",
