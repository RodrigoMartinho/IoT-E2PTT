    {
        "id": "ff658ff4336ff480",
        "type": "ui-template",
        "z": "f00ad3ea53f3c7ed",
        "group": "56e3cde2fed957ac",
        "page": "",
        "ui": "",
        "name": "Botão Luz",
        "order": 1,
        "width": 0,
        "height": 0,
        "head": "",
        "format": "<template>\n    <v-btn class=\"button\" stacked @click=\"alternar\">\n        <div class=\"title\">Luz</div>\n        <v-icon class=\"icon\" :style=\"estiloIcone\">{{ icon }}</v-icon>\n    </v-btn>\n</template>\n\n<script>\n    export default {\n        data() {\n            return {\n                value: \"OFF\"\n            };\n        },\n        computed: {\n            icon() {\n                return this.value === \"ON\" ? \"mdi-lightbulb-on-outline\" : \"mdi-lightbulb-outline\";\n            },\n            estiloIcone() {\n                return {\n                    color: this.value === \"ON\" ? '#BD9608' : '#A9A9A9',\n                    textShadow: this.value === \"ON\" ? '0px 0px 10px #BD9608' : '0px 0px 0px',\n                    fontSize: '40px'\n                };\n            }\n        },\n        methods: {\n            alternar: function () {\n                if (this.value === 'ON') {\n                    this.desligar();\n                } else {\n                    this.ligar();\n                }\n            },\n            ligar: function () {\n                if (this.value === 'OFF') {\n                    this.send({ payload: 'ON' });\n                    this.value = \"ON\";\n                }\n            },\n            desligar: function () {\n                if (this.value === 'ON') {\n                    this.send({ payload: 'OFF' });\n                    this.value = \"OFF\";\n                }\n            }\n        },\n        watch: {\n            msg: function(val) {\n                if (val && val.payload !== undefined) {\n                    // Sincroniza o estado interno com o que vem do ESP (payload)\n                    if (val.payload === \"ON\" || val.payload === \"OFF\") {\n                        this.value = val.payload;\n                    }\n                }\n            }\n        }\n    }\n</script>\n\n<style>\n    .button {\n        display: flex;\n        flex-direction: column;\n        margin: auto;\n        height: 100% !important;\n        width: 100% !important;\n        background-color: #c0dbfa !important;\n        color: #000000 !important;\n        border: 1px solid #000000;\n        border-radius: 18px;\n    }\n</style>",
        "storeOutMessages": true,
        "passthru": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
